<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme"
        android:networkSecurityConfig="@xml/network_security_config">
        <!-- Cleartext (L2, security review 2026-10-22): no app-wide usesCleartextTraffic any more. The dev stand's WebView
             loads http://10.0.2.2:8480 (server.url in capacitor.config.ts); res/xml/network_security_config.xml allows plain
             http for 10.0.2.2 and localhost only. allowBackup is off: the session cookie and local data are not copied out. -->

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Result-moment haptics (D-50, result-moment.md §2's per-tier `vibrate(...)` column).
         `navigator.vibrate()` under a genuine user gesture already returns `true` on this
         emulator/WebView build (Android 15, WebView 124) even without this permission, and
         `logcat`/`dumpsys package` show no SecurityException either way (verified live,
         2026-09-26, on emulator-5554 with and without this line) — so this specific build's JS
         return value doesn't prove the permission changes behavior here. Kept anyway: any app
         calling the Vibration API is expected to declare `VIBRATE` (it is a normal, not
         dangerous, permission — free to request), and other Android/WebView combinations are
         documented to silently drop the actual motor call without it even when the JS promise
         still resolves true, which the emulator's virtual vibrator can't be relied on to surface. -->
    <uses-permission android:name="android.permission.VIBRATE" />
</manifest>
