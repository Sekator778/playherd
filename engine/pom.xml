<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>crowdvsmarket</groupId>
  <artifactId>engine</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <packaging>jar</packaging>

  <name>crowd-vs-market engine</name>
  <description>
    Off-chain leverage/liquidation calculator and round simulator for the
    "C2 Crowd vs Market" project. Implements docs/research/hl_liquidation_math.md
    (BTC isolated-margin liquidation math, tier0) with no runtime dependencies.
  </description>

  <properties>
    <maven.compiler.release>21</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>

    <!-- Current stable versions as of 2026-09-25 (checked against Maven Central metadata).
         assertj-core pinned to 3.27.6 rather than the newest 3.27.7: both are current-stable
         patch releases, but 3.27.7 pulls net.bytebuddy:byte-buddy:1.18.3, which is not in this
         machine's local Maven repo and ~/.m2/settings.xml forces offline mode (deliberate,
         machine-wide guard against contacting anything but Maven Central — not touched here);
         3.27.6 needs byte-buddy 1.17.7, already cached. -->
    <junit.jupiter.version>6.1.3</junit.jupiter.version>
    <assertj.version>3.27.6</assertj.version>
    <maven.compiler.plugin.version>3.16.0</maven.compiler.plugin.version>
    <maven.surefire.plugin.version>3.6.0</maven.surefire.plugin.version>
  </properties>

  <dependencies>
    <!-- No runtime dependencies: plain CSV parsing of the fixture files is enough. -->
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>${junit.jupiter.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.assertj</groupId>
      <artifactId>assertj-core</artifactId>
      <version>${assertj.version}</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <finalName>${project.artifactId}</finalName>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>${maven.compiler.plugin.version}</version>
        <configuration>
          <release>${maven.compiler.release}</release>
          <showWarnings>true</showWarnings>
          <compilerArgs>
            <arg>-Xlint:all</arg>
            <arg>-Werror</arg>
          </compilerArgs>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>${maven.surefire.plugin.version}</version>
      </plugin>
    </plugins>
  </build>
</project>
