# Java / Maven
target/
*.class

# The event journal of a server started from the repository directory (D-107; herd.journal.dir, default ./journal)
/journal/
/server/journal/
*.importing

# Rust
chain/target/

# Node
node_modules/
web/dist/

# OS / IDE
.DS_Store
.idea/
*.iml
.vscode/

# Secrets — never commit keys, wallets, API keys
*.pem
*.key
.env
.env.*

# Android release-signing keystores (docs/ops/ci.md "ANDROID_KEYSTORE_*") — CI decodes these from
# secrets into a runner temp path, never into the repo; this is only a backstop against an
# accidental local `cp`.
*.jks
*.keystore

# Local-only notes with home-network/identifying details (D-39 redaction, 2026-09-26)
.local/

# Android / Capacitor
.gradle/
build/
local.properties
*.apk
*.aab

# deploy/ (VPS delivery, docs/ops/deploy.md) — state and backups deploy.sh/backup.sh write on the
# VPS itself; never meant to be committed even if someone runs these scripts from a repo checkout.
deploy/.deploy-state/
deploy/backups/

# Claude Code agent worktrees (workflow isolation) — local scratch, never committed.
.claude/worktrees/

# Python
__pycache__/
*.pyc

# Logs
*.log
